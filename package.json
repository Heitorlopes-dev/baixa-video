{
  "name": "baixa-video",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "bun run gen:capability && vite",
    "build": "bun run gen:capability && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "sidecars": "bash scripts/fetch-sidecars.sh",
    "ok": "bun run check-types && bun test && vite build",
    "build:win": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc",
    "gen:capability": "bun scripts/gen-capability.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "packageManager": "bun@1.4.0"
}
