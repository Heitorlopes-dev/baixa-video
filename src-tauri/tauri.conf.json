{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baixa Video",
  "version": "0.4.0",
  "identifier": "dev.heitorlopes.baixa-video",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Baixa Vídeo",
        "width": 760,
        "height": 640,
        "minWidth": 560,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self' http://localhost:1420 ws://localhost:1420 ws://localhost:1421; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg", "binaries/ffprobe", "binaries/deno"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMkREQzYzOTZBRDJFN0UKUldSK0xxMldZOXd0NjdmOFpFQjROVDdERzA4emJ4bWkreHIrT1J0TFFsbTJiazBNUVVHaW93Mi8K",
      "endpoints": ["https://github.com/Heitorlopes-dev/baixa-video/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
